<odoo>
    <record id="action_comodel_xml_id" model="ir.actions.act_window">
        <field name="name">Action Name</field>
        <field name="res_model">comodel.name</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Add a new record
              </p><p>
                Description of the model.
              </p>
            </field>
    </record>
    
    <record id="comodel_name_form_view" model="ir.ui.view">
        <field name="name">comodel.name.form.view</field>
        <field name="model">comodel.name</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Field Without Label -->
                    <h1><field name="name"/></h1>
                    <!-- Notebook -->
                    <notebook>
                        <page name="Page One">
                            <field name="field_2many"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="comodel_name_list_view" model="ir.ui.view">
        <field name="name">comodel.name.list.view</field>
        <field name="model">comodel.name</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="name"/>
                <field name="field_2many" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    
    <record id="comodel_name_search_view" model="ir.ui.view">
        <field name="name">comodel.name.search.view</field>
        <field name="model">comodel.name</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>
</odoo>