        <!-- Loan Tag Data -->
        <record id="tag_high_priority" model="loan.application.tag">
            <field name="name">High Priority</field>
        </record>
        <record id="tag_standard_priority" model="loan.application.tag">
            <field name="name">Standard Priority</field>
        </record>
        <record id="tag_low_priority" model="loan.application.tag">
            <field name="name">Low Priority</field>
        </record>

        <!-- Loan Purpose Tags -->
        <record id="tag_new_motorcycle_purchase" model="loan.application.tag">
            <field name="name">New Motorcycle Purchase</field>
        </record>
        <record id="tag_preowned_motorcycle_purchase" model="loan.application.tag">
            <field name="name">Pre-Owned Motorcycle Purchase</field>
        </record>
        <record id="tag_accessories_financing" model="loan.application.tag">
            <field name="name">Accessories Financing</field>
        </record>

