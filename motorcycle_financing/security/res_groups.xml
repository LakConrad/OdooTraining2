<odoo>
    <!-- Odoo 19 will introduce the concept of privileges -->
    <record id="module_main_category" model="ir.module.category">
        <field name="name">Main Category</field>
    </record>
    <record model="res.groups.privilege" id="res_group_privilege">
        <field name="name">Group Privilege</field>
        <field name="category_id" ref="module_main_category"/>
    </record>
    <record id="group_app_user" model="res.groups">
        <field name="name">App User</field>
        <field name="privilege_id" ref="res_group_privilege"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <data noupdate="1">
        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval= "[Command.link(ref('group_app_user'))]"/>
        </record>
    </data>
</odoo>