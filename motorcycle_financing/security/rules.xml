<odoo>
    <data noupdate="1">
        <record id="no_signed_modify" model="ir.rule">
            <field name="name">User can not modify or delete signed loans</field>
            <field name="model_id" ref="model_loan_application"/>
            <field name="groups" eval="[(4, ref('group_financing_user'))]"/>
            <field name="domain_force">[('state','not in',['signed'])]</field>
            <field name="perm_read">0</field>
            <field name="perm_create">0</field>
        </record>
        <record id="loan_can_modify_all" model="ir.rule">
            <field name="name">Admin can modify or delete all loans</field>
            <field name="model_id" ref="model_loan_application"/>
            <field name="groups" eval="[(4, ref('group_financing_admin'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>
    </data>
</odoo>